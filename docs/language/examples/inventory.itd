class Inventory {
    let mut stock: int := 0;
    pub fn this(initial: int) { if initial >= 0 { this.stock = initial; } }
    pub fn sell(quantity: int) -> bool {
        if quantity <= 0 or quantity > this.stock { return false; }
        this.stock = this.stock - quantity;
        return true;
    }
    pub fn available() -> int { return this.stock; }
}
let first := Inventory(10);
let second := Inventory(5);
first.sell(3);
if not second.sell(6) { print("Stock insuficiente"); }
print(to_string(first.available()));
print(to_string(second.available()));
